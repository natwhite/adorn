{
  "compileOnSave": true,
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    // GAP-7: `moduleResolution` was previously IMPLIED. With `module: commonjs` it implied
    // `node10`, which TypeScript 6 reports as deprecated (TS5107) whenever it is named
    // explicitly, and which TypeScript 7 removes outright. Making it explicit as `node10`
    // would therefore have required `ignoreDeprecations` and still died at the 7.x move.
    //
    // `node16` is the explicit, non-deprecated setting that survives 7.x. `module` must be
    // set alongside it (TS5110: moduleResolution=node16 requires module=node16). Emit is
    // unchanged in practice — package.json has no `"type": "module"`, so every file here is
    // still CommonJS and still emits `require`. Verified: build 0, typecheck 0, 444 tests.
    //
    // This does NOT move the project to TypeScript 7 — DEC-013 blocks that (the TS 7 npm
    // package ships no JS compiler API and ts-jest requires >=4.3 <7). It only removes one
    // of the two config-level blockers DEC-013 lists.
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2019",
    // SMELL-12: `strict` stays false (strictNullChecks / noImplicitAny /
    // strictPropertyInitialization carry real, deferred cost). These five strict sub-flags
    // were re-measured post-@Returns/Fuzzing-B/Observability-O1 and enabled together as the
    // genuinely-free staged subset — all three build/typecheck paths inherit them from here.
    "strict": false,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "lib": ["es2019", "dom"],
    "declaration": true,
    // Source/declaration maps OFF (npm-release prep): the published package ships `dist` only
    // (files:["dist"]), not `src`, so a `.js.map`/`.d.ts.map` pointing at `../src/*.ts` is dead weight
    // (~half the tarball) and "go to source" cannot resolve anyway. The `.d.ts` themselves still ship and
    // carry the JSDoc (DEC-064). ts-jest forces its own in-memory maps, so tests are unaffected.
    "declarationMap": false,
    "sourceMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    // `spike/` is throwaway feasibility-spike code (docs/sensitive-flow-spike.md). It must
    // never reach `dist/` — the same rule `examples/` is excluded under, for the same reason.
    "spike",
    // `tools/` is build-time tooling (the sensitive-flow detector, docs/sensitive.md). It is
    // NOT library code and must never reach `dist/` or the runtime export surface — same rule as
    // `spike/` and `examples/`. It is typechecked by tsconfig.test.json and tested by jest.
    "tools",
    // `addons/` is the opt-in `@adorn/test` fuzzing add-on (docs/fuzzing-foundation.md). It takes
    // `fast-check` as a real devDependency and MUST never reach `dist/` or the runtime export
    // surface — this is the DEC-019 isolation for fast-check, exactly as `tools/` is for the
    // sensitive-flow detector. Excluding it here is what keeps `require('adorn')` free of fast-check
    // (asserted by addons/test/isolation.test.ts). Typechecked by tsconfig.test.json, tested by jest.
    "addons",
    // `examples/` is demonstration code, not library code. Before P0.4 the demo lived at
    // `src/Tests.ts` and was compiled into `dist/src/Tests.js` — the published package shipped
    // a demo script. Excluded here so that cannot happen again; `npm run demo` runs it through
    // ts-node, and `tsconfig.test.json` still typechecks it.
    "examples",
    "**/*.test.ts"
  ]
}
