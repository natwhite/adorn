{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    // `examples/` is excluded from the *build* (it must not reach `dist/`) but it still has to
    // compile — a demo that no longer typechecks is a broken demo nobody notices. This config
    // is what `npm run typecheck` runs, so the demo is covered without being emitted.
    "examples/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
