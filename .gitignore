# Project exclude paths
/dist/
# Build output from the tools/ scratch utilities (e.g. tools/q31/dist) — source stays tracked, builds don't.
tools/*/dist/
# Stray compiled output — a local tsc can emit .js beside root/test .ts config and source files; the .ts is the source of truth.
test/*.js
/tsup.config.js
/node_modules/

# Local secrets — never commit (Q-31 harness reads OPENAI_API_KEY from here)
.env
.env.local
.env.*.local

# JetBrains IDE settings
/.idea/