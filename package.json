{
  "name": "adorn",
  "version": "1.0.0",
  "description": "A collection of convinient TypeScript decorators and simplified decorator creation wrapper",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adorn": "dist/src/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && tsc -p tsconfig.cli.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "demo": "ts-node examples/demo.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "typescript",
    "decorators",
    "parameter-decorators",
    "method-decorators",
    "field-decorators",
    "validation",
    "contracts",
    "design-by-contract"
  ],
  "author": "natwhite",
  "license": "ISC",
  "dependencies": {
    "tslib": "^1.10.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.19.0"
  }
}
