{
  "name": "adorn",
  "version": "0.1.0",
  "description": "One TypeScript declaration → an LLM tool schema, a runtime validator, JSON Schema, and docs, derived from a single source.",
  "keywords": [
    "typescript",
    "decorators",
    "validation",
    "runtime-validation",
    "contracts",
    "design-by-contract",
    "json-schema",
    "llm",
    "tool-calling",
    "function-calling",
    "openai"
  ],
  "homepage": "https://adorn-ts.dev",
  "bugs": "https://github.com/natwhite/adorn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/natwhite/adorn.git"
  },
  "license": "MIT",
  "author": "natwhite",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/addons/otel/index.d.ts",
      "default": "./dist/addons/otel/index.js"
    },
    "./test": {
      "types": "./dist/addons/test/index.d.ts",
      "default": "./dist/addons/test/index.js"
    }
  },
  "bin": {
    "adorn": "dist/src/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && tsc -p tsconfig.cli.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "demo": "ts-node examples/demo.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.19.0"
  }
}
